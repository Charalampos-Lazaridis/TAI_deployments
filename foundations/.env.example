OPENAI_API_KEY=

# Session 2 — Pinecone (index must use dimension 1536 for text-embedding-3-small, metric cosine)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional — leave blank to use the default namespace
PINECONE_NAMESPACE=

# Optional — /ingest chunking defaults (characters); per-request fields override these
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Optional — /ask ignores retrieved chunks scoring below this cosine similarity
RAG_MIN_SCORE=0.25

# Streamlit UI (rag_ui.py) — which API to call; local: http://127.0.0.1:8000
RAG_API_URL=https://tai-deployments.onrender.com
